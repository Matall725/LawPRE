{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LawPRE deck plan",
  "description": "逐页内容与中文讲稿。讲稿是口语化的正文，不含列表或标记。",
  "type": "object",
  "additionalProperties": false,
  "required": ["slides"],
  "properties": {
    "slides": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slide_no", "kind", "title", "key_message", "body", "source_ids", "notes_zh", "duration_seconds"],
        "properties": {
          "slide_no": {"type": "integer", "minimum": 1},
          "kind": {"enum": ["cover", "issue", "rule", "analysis", "counterargument", "conclusion"]},
          "title": {"type": "string", "minLength": 2, "maxLength": 40},
          "key_message": {"type": "string", "minLength": 4, "maxLength": 80},
          "body": {
            "type": "array",
            "maxItems": 5,
            "items": {"type": "string", "minLength": 1, "maxLength": 60}
          },
          "issue_id": {"type": "string", "pattern": "^I\\d{2}$"},
          "source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^S\\d{3}$"}
          },
          "notes_zh": {"type": "string", "minLength": 40},
          "duration_seconds": {"type": "integer", "minimum": 10, "maximum": 180}
        }
      }
    }
  }
}
